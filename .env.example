# llmorch — API key template
#
# Copy this file to `.env` and put your real keys THERE, not here.
# `.env` is gitignored; this file is the committed template.
#
#     copy .env.example .env
#
# Milestone 1 needs NO keys at all — it runs entirely against the mock provider.

# ---------------------------------------------------------------------------
# v1 providers — needed from Milestone 2 onward
# ---------------------------------------------------------------------------

# Groq — https://console.groq.com/keys   (free, no card)
# 30 req/min | 6,000 tokens/min | 14,400 req/day | resets UTC midnight
# The 6,000 TPM cap is the tightest constraint in the whole system.
GROQ_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey   (free tier)
# 10 req/min | 250,000 tokens/min | 250 req/day | resets PACIFIC midnight
# 1M context. The scarce long-context resource — spend its 250/day carefully.
GEMINI_API_KEY=


# ---------------------------------------------------------------------------
# M3.5 bonus providers — leave blank until then
# ---------------------------------------------------------------------------

# NVIDIA NIM — https://build.nvidia.com   (free, no card)
# Limits undocumented; llmorch discovers them from response headers and 429s.
NVIDIA_NIM_API_KEY=

# Mistral La Plateforme — https://console.mistral.ai   (free tier, phone verification)
# ~1B tokens/month but only ~1-2 req/min.
# NOTE: the free tier opts your prompts into Mistral's training data.
MISTRAL_API_KEY=


# ---------------------------------------------------------------------------
# M5 — PAID. Costs real money.
# Requires the --allow-paid flag at runtime even when this key is set.
# ---------------------------------------------------------------------------

# Perplexity — ~$1/M tokens PLUS $5-14 per 1,000 requests.
PERPLEXITY_API_KEY=


# ---------------------------------------------------------------------------
# Runtime settings
# ---------------------------------------------------------------------------

# Hard ceiling on real spend per run, USD. 0.00 = paid providers disabled.
LLMORCH_MAX_USD=0.00

# Overrides (optional — sensible defaults are used when unset)
# LLMORCH_RUNS_DIR=
# LLMORCH_STATE_DB=
