# llmorch — copy this to .env and fill in whichever keys you have.
#
# .env is gitignored, along with .env.backup and anything else matching .env*,
# so a real key never sits in a trackable file. Blank values are skipped, which
# means an unfilled placeholder here never shadows a real environment variable.
#
# Format is strict: KEY=value, no quotes, no spaces around the '='.
#
# None of these are needed to try the project. `llmorch run "build a notes app"`
# exercises the whole pipeline against the mock provider with no network at all.

# --- Enabled in models.yaml -------------------------------------------------
# Groq        https://console.groq.com    free — this account sees ~1,000
#                                          requests/day and 8,000 tokens/minute
GROQ_API_KEY=
# Gemini      https://ai.google.dev       free — 20 requests/minute on 3.x flash
GEMINI_API_KEY=
# OpenRouter  https://openrouter.ai       free tier covers the `:free` models
OPENROUTER_API_KEY=

# --- Discovered but not enabled ---------------------------------------------
# `llmorch discover` asks each key which models it can reach, spending no
# tokens. On the account this was developed against, Cerebras and NVIDIA NIM
# both list models and then refuse every completion, and the rest are paid — so
# none of these are enabled in models.yaml. Yours may differ; run discover.
CEREBRAS_API_KEY=
NVIDIA_NIM_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
FIREWORKS_API_KEY=
OPENCODE_ZEN_API_KEY=

# --- Paid; also requires --allow-paid at runtime ----------------------------
PERPLEXITY_API_KEY=

# --- Runtime ----------------------------------------------------------------
# Hard ceiling on real spend. 0 disables every paid provider outright, and the
# governor refuses them before a request is built rather than after.
LLMORCH_MAX_USD=0.00
